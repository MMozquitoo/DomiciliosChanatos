# Chanatos WhatsApp Agent — Variables de entorno
# Copia este archivo a .env (cp env.example .env) y completa tus valores.
# .env NUNCA se sube a git (esta en .gitignore).

# ── Anthropic ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5
ANTHROPIC_MODEL=claude-sonnet-5
# Esfuerzo de razonamiento: low | medium | high. Vacio = no enviar el parametro.
ANTHROPIC_EFFORT=low
# Opcional, default 4096. El razonamiento interno cuenta contra este tope.
# ANTHROPIC_MAX_TOKENS=4096

# ── Proveedor de WhatsApp ──────────────────────────────────
WHATSAPP_PROVIDER=zernio

# ── Zernio (crea tu cuenta gratis en zernio.com) ───────────
ZERNIO_API_KEY=sk_...
ZERNIO_WEBHOOK_SECRET=inventa-un-secreto-aqui
# Opcional: solo se usa para el chequeo de conexion al arrancar
ZERNIO_ACCOUNT_ID=

# ── Cola de pedidos web (chanatos-web -> POS) ───────────────
# Secreto compartido: mismo valor en Vercel (chanatos-web) y en el .env del POS
WEB_ORDERS_SECRET=inventa-otro-secreto-aqui

# ── Servidor ───────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── Base de datos ──────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
